REBELMOUSE_STDLIB.createElementChangeListener('.comment--item-word-count', function (wordCountDiv) {
  
  // const minCount = wordCountDiv.querySelector('.comment--item-word-count-min').textContent;
  const userCount = wordCountDiv.querySelector('.comment--item-word-count-user').textContent;
  const maxCount = wordCountDiv.querySelector('.comment--item-word-count-max').textContent;
  
  wordCountDiv.setAttribute('tabindex', '0');
  wordCountDiv.setAttribute('role', 'status');
  wordCountDiv.setAttribute('aria-live', 'polite');
  wordCountDiv.setAttribute('aria-label', `Word count: ${userCount} of ${maxCount} words used`);
  
  const observer = new MutationObserver(() => {
    // const updatedMin = wordCountDiv.querySelector('.comment--item-word-count-min').textContent;
    const updatedUser = wordCountDiv.querySelector('.comment--item-word-count-user').textContent;
    const updatedMax = wordCountDiv.querySelector('.comment--item-word-count-max').textContent;
    
    wordCountDiv.setAttribute('aria-label', `Word count: ${updatedUser} of ${updatedMax} words used`);
  });
  
  observer.observe(wordCountDiv, { 
    childList: true, 
    subtree: true, 
    characterData: true 
  });
});
    

});

